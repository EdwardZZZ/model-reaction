{
  // Default project for IDE diagnostics and full source/test type checking.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

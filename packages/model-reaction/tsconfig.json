{
  // Visit https://aka.ms/tsconfig to read more about this file
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "types": ["jest"],

    // Other Outputs
    "declaration": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.test.ts", "**/*.test.tsx"],
}

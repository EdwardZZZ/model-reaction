{
  "manifest_version": 3,
  "name": "Model Reaction DevTools",
  "version": "0.1.0",
  "description": "Inspect model-reaction data trees, field dependency graphs, and change timelines.",
  "minimum_chrome_version": "110",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["jest", "node"],
    // Resolve the workspace dependency to the library *source* for typecheck,
    // mirroring the jest moduleNameMapper so neither depends on a prior build.
    "baseUrl": ".",
    "paths": {
      "model-reaction": ["../model-reaction/src/index.ts"],
      "model-reaction/devtools": ["../model-reaction/src/devtools.ts"]
    }
  },
  "include": ["src", "build.mjs", "types"]
}

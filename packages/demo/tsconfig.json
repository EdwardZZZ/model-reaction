{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    // Resolve the workspace dependency to the library source for typecheck,
    // mirroring the Vite aliases so neither depends on a prior library build.
    "baseUrl": ".",
    "paths": {
      "model-reaction": ["../model-reaction/src/index.ts"],
      "model-reaction/react": ["../model-reaction/src/react.ts"],
      "model-reaction/devtools": ["../model-reaction/src/devtools.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

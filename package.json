{
  "name": "model-reaction-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for model-reaction: the core library, its DevTools extension, and a demo app.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "build:lib": "pnpm --filter model-reaction run build",
    "test:lib": "pnpm --filter model-reaction run test",
    "test:devtools": "pnpm --filter model-reaction-devtools run test"
  },
  "license": "ISC"
}
